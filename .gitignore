/target/
/build/
/dist/
/bin/
*.exe
*.dll
*.so
*.dylib
*.a
*.o

# ==========================================
# Language-Specific & Dependency Artifacts
# ==========================================
# Rust
**/*.rs.bk
Cargo.lock # Optional: remove if ABC 2.0 is a binary application, keep if a library

